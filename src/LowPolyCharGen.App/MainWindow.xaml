<Window x:Class="LowPolyCharGen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LowPolyCharGen.App"
        xmlns:core="clr-namespace:LowPolyCharGen;assembly=LowPolyCharGen.Core"
        Title="Low Poly Character Generator" Width="1220" Height="960" MinWidth="900" MinHeight="600"
        Background="{StaticResource PanelBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= options ================= -->
        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0" Padding="12,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="28" Content="Randomise" Click="OnRandomise" ToolTip="Roll a random character" />
                        <Button Grid.Column="2" Height="28" Content="Load preset…" Click="OnLoadPreset" />
                        <Button Grid.Column="4" Height="28" Content="Save preset…" Click="OnSavePreset" />
                    </Grid>
                    <Button Height="34" Content="Export FBX…" Style="{StaticResource PrimaryButton}" Click="OnExport" />
                    <TextBlock x:Name="StatusText" Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" Text="T-pose rig on the Toon Soldiers or UE5 mannequin skeleton, with a painted texture." />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,6,2">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource Card}" Header="CHARACTER">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Name">
                                <TextBox Height="24" VerticalContentAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Rig"
                                                    ToolTip="Toon Soldiers: the pack's chunky proportions on its Bip001 skeleton, so its animations play on it. UE5 mannequin: realistic proportions on SK_Mannequin.">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:RigTarget}}" SelectedItem="{Binding Rig}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Edition"
                                                    ToolTip="Uniform edition: sets the clothing, hat, gear and camouflage colours for desert, snow or jungle kit">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:Edition}}" SelectedItem="{Binding Edition}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Gender">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:Gender}}" SelectedItem="{Binding Gender}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Build">
                                <Slider Minimum="0" Maximum="1" Value="{Binding Build}" LargeChange="0.1" SmallChange="0.05"
                                        ToolTip="Slim to heavy" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Skin" Margin="0">
                                <local:ColorPicker Color="{Binding SkinColor}" />
                            </HeaderedContentControl>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Card}" Header="HEAD">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Shape">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:HeadShape}}" SelectedItem="{Binding HeadShape}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Size">
                                <Slider Minimum="0.9" Maximum="1.4" Value="{Binding HeadSize}" LargeChange="0.05" SmallChange="0.01"
                                        ToolTip="1.0 is the mannequin's head; larger is more toon" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Ears">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:EarShape}}" SelectedItem="{Binding Ears}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Eye colour">
                                <local:ColorPicker Color="{Binding EyeColor}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Hair">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:HairStyle}}" SelectedItem="{Binding Hair}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Facial hair">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:FacialHair}}" SelectedItem="{Binding FacialHair}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Hair colour" Margin="0">
                                <local:ColorPicker Color="{Binding HairColor}" />
                            </HeaderedContentControl>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Card}" Header="TORSO">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Style">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:TorsoStyle}}" SelectedItem="{Binding Torso}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Colour">
                                <local:ColorPicker Color="{Binding ShirtColor}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Camouflage" Margin="0" ToolTip="Printed on the shirt, trousers and hat">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:Camouflage}}" SelectedItem="{Binding Camouflage}" />
                            </HeaderedContentControl>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Card}" Header="LEGS">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Style">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:LegsStyle}}" SelectedItem="{Binding Legs}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Colour">
                                <local:ColorPicker Color="{Binding TrousersColor}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Boots" Margin="0">
                                <local:ColorPicker Color="{Binding BootsColor}" />
                            </HeaderedContentControl>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Card}" Header="ADD-ONS">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Hat">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:HatStyle}}" SelectedItem="{Binding Hat}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Hat colour">
                                <local:ColorPicker Color="{Binding HatColor}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Eyewear">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:EyewearStyle}}" SelectedItem="{Binding Eyewear}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Backpack">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:BackpackStyle}}" SelectedItem="{Binding Backpack}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Vest">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:VestStyle}}" SelectedItem="{Binding Vest}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Belt">
                                <ComboBox Style="{StaticResource EnumCombo}" ItemsSource="{local:EnumValues {x:Type core:BeltStyle}}" SelectedItem="{Binding Belt}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Gear colour">
                                <local:ColorPicker Color="{Binding GearColor}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Accent" ToolTip="Belt, scarf and bedroll">
                                <local:ColorPicker Color="{Binding AccentColor}" />
                            </HeaderedContentControl>
                            <UniformGrid Columns="2" Margin="0,2,0,0">
                                <CheckBox Content="Gloves" IsChecked="{Binding Gloves}" Margin="0,3" />
                                <CheckBox Content="Scarf" IsChecked="{Binding Scarf}" Margin="0,3" />
                                <CheckBox Content="Knee pads" IsChecked="{Binding KneePads}" Margin="0,3" />
                                <CheckBox Content="Elbow pads" IsChecked="{Binding ElbowPads}" Margin="0,3" />
                            </UniformGrid>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource Card}" Header="OUTPUT">
                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Row}" Header="Texture size" ToolTip="Side length of the exported texture in pixels">
                                <ComboBox x:Name="TextureSizeCombo" Height="24" SelectedItem="{Binding TextureSize}" />
                            </HeaderedContentControl>
                            <CheckBox Content="Flat shaded (faceted normals)" IsChecked="{Binding FlatShaded}" Margin="0,2" />
                            <CheckBox x:Name="IkBonesCheck" Content="Include IK bones (mannequin rig only)" IsChecked="True" Margin="0,2"
                                      Checked="OnRigOptionChanged" Unchecked="OnRigOptionChanged" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ================= preview ================= -->
        <Border x:Name="ViewportHost" Grid.Column="1" ClipToBounds="True"
                MouseDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove" MouseUp="OnViewportMouseUp" MouseWheel="OnViewportMouseWheel">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#7C8796" Offset="0" />
                    <GradientStop Color="#3C424D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Viewport3D x:Name="Viewport" IsHitTestVisible="False">
                    <Viewport3D.Camera>
                        <PerspectiveCamera x:Name="Camera" FieldOfView="32" UpDirection="0,0,1" NearPlaneDistance="10" FarPlaneDistance="4000" />
                    </Viewport3D.Camera>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#6A6A6E" />
                                <DirectionalLight Color="#B4B0A8" Direction="-0.45,0.75,-0.55" />
                                <DirectionalLight Color="#3C4250" Direction="0.6,-0.5,-0.2" />
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <ModelVisual3D x:Name="SceneVisual" />
                </Viewport3D>

                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,7" CornerRadius="6" Background="#D0FFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pose" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="PoseCombo" Width="92" Style="{StaticResource EnumCombo}"
                                  ItemsSource="{local:EnumValues {x:Type core:PreviewPose}}" SelectionChanged="OnViewOptionChanged"
                                  ToolTip="Preview only: the export is always the T-pose" />
                        <CheckBox x:Name="SkeletonCheck" Content="Skeleton" VerticalAlignment="Center" Margin="14,0,0,0"
                                  Checked="OnViewOptionChanged" Unchecked="OnViewOptionChanged" />
                        <CheckBox x:Name="TurntableCheck" Content="Turntable" VerticalAlignment="Center" Margin="14,0,0,0"
                                  Checked="OnTurntableChanged" Unchecked="OnTurntableChanged" />
                        <Button Content="Reset view" Margin="14,0,0,0" Padding="8,1" Click="OnResetView" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatsText" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,12"
                           Foreground="#E8ECF2" FontSize="12" />
                <TextBlock x:Name="BusyText" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,16,0"
                           Foreground="#E8ECF2" FontSize="12" Text="Painting…" Visibility="Collapsed" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12" Foreground="#B8C0CC" FontSize="11"
                           Text="Drag: orbit  ·  Right-drag: pan  ·  Wheel: zoom" />
            </Grid>
        </Border>
    </Grid>
</Window>
